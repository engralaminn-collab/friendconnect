{
  "name": "friendconnect",
  "version": "1.0.0",
  "private": true,
  "description": "FriendConnect — the all-in-one workspace for community, CRM, AI marketing, education consultancy, diagrams, video and voice studios.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:socket": "npm run build:server && node --env-file=.env dist/server/index.cjs",
    "build": "next build",
    "build:server": "node scripts/build-server.mjs",
    "start": "next start -H 0.0.0.0",
    "start:socket": "npm run build:server && cross-env NODE_ENV=production node --env-file=.env dist/server/index.cjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:cleanup-media": "tsx --env-file=.env scripts/cleanup-media.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "nanoid": "^3.3.20",
    "next": "^15.1.3",
    "nodemailer": "^6.10.1",
    "rate-limiter-flexible": "^5.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
