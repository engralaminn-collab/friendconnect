# ============================================================================
# FriendConnect — environment configuration
# Copy to `.env` (`.env.local` for Next.js local development) and fill in.
# NEVER commit a real .env file. Everything here is a safe placeholder.
# ============================================================================

# ---- Application -----------------------------------------------------------
NODE_ENV=development                      # development | test | production
APP_ENV=development                       # free-form label used in logs
APP_URL=http://localhost:3000             # canonical public origin
# Comma-separated extra origins allowed for CORS/CSRF checks (same-origin always allowed)
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info                            # debug | info | warn | error
SENTRY_DSN=                               # optional error monitoring DSN

# ---- MySQL 8 (required in production) --------------------------------------
# mysql2 connection URL. Use a least-privilege application user.
DATABASE_URL=mysql://friendconnect:change-me@127.0.0.1:3306/friendconnect
MYSQL_POOL_MAX=10
# Set to "false" only when connecting to a TLS-terminating local proxy.
MYSQL_TLS=false

# ---- Workspace access -------------------------------------------------------
# The /app workspace is local-first and needs no account. Set to 1 only when
# the workspace must sit behind the session cookie (shared/team deployment).
WORKSPACE_REQUIRES_AUTH=0
# Bearer token required by /api/agent/* when set. Generate: openssl rand -hex 32
AGENT_TOKEN=

# ---- Authentication / sessions ---------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-64-random-bytes-please
SESSION_TTL_DAYS=30                       # rolling session lifetime
COOKIE_SECURE=auto                        # auto | true | false (auto = on when NODE_ENV=production)
COOKIE_SAMESITE=lax                       # lax | strict | none
COOKIE_NAME=fc_session
# Window (minutes) and threshold for brute-force lockouts on auth endpoints
AUTH_LOCK_WINDOW_MIN=15
AUTH_LOCK_THRESHOLD=10

# ---- Object storage (media uploads) ----------------------------------------
# MEDIA_DRIVER=s3   -> private S3-compatible bucket (production)
# MEDIA_DRIVER=local -> private local directory, never served from /public
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./.private-media
MEDIA_MAX_UPLOAD_MB=25
# S3-compatible endpoint (AWS, MinIO, Cloudflare R2, Backblaze B2, ...)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=friendconnect-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true                  # true for MinIO/local; false for AWS
S3_PRESIGN_TTL_SEC=300

# ---- WebSocket / Socket.IO --------------------------------------------------
WEBSOCKET_PATH=/api/realtime
# Comma-separated Socket.IO CORS origins. Defaults to APP_URL when empty.
WEBSOCKET_CORS_ORIGINS=

# ---- STUN / TURN (WebRTC) ---------------------------------------------------
# Comma-separated STUN/TURN server URLs handed to authenticated clients.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=                                # e.g. turns:turn.example.com:5349
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: shared secret for time-limited ephemeral TURN credentials (RFC 5766 REST API)
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SEC=3600

# ---- Optional SFU (group calls, LiveKit) -----------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Optional Redis (rate-limit/shared realtime state across instances) ----
# When unset, in-memory adapters are used (single-instance deployments).
REDIS_URL=

# ---- Email (verification + password reset) ---------------------------------
# SMTP connection URL. When unset, emails are logged instead of sent (dev mode).
SMTP_URL=                                 # smtp://user:pass@smtp.example.com:587
EMAIL_FROM="FriendConnect <no-reply@example.com>"
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_API_PER_MIN=120                # generic authenticated API limit per user
RATE_LIMIT_AUTH_PER_MIN=10                # register/login/logout per IP
RATE_LIMIT_UPLOAD_PER_MIN=20              # media uploads per user

# ---- Health checks ----------------------------------------------------------
HEALTH_CHECK_TOKEN=                       # bearer token for /api/health/deep
